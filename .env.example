# Google AI Studio Gemini API key
GEMINI_API_KEY=

# VTR MCP server
VTR_MCP_URL=http://128.23.8.200:8790/sse
VTR_MCP_API_KEY=

# Optional realtime providers
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_APP_KEY=
VOLCENGINE_TEXT_API_KEY=
CUSTOM_REALTIME_API_KEY=# GEMINI_API_KEY: Required for Gemini AI API calls (Live API, Search grounding, TTS, Image generation).
# AI Studio automatically injects this at runtime from user secrets.
# For local deployment, set this to your Google AI Studio Gemini API Key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VTR_MCP_URL: URL of your local or remote VTR MCP SSE Server (e.g., http://128.23.8.200:8790/sse)
VTR_MCP_URL="http://128.23.8.200:8790/sse"

# VTR_MCP_API_KEY: Authentication X-API-Key for the VTR MCP Server
VTR_MCP_API_KEY="your-vtr-mcp-api-key-here"

# Realtime providers are defined in config/realtime.providers.json.
# Each provider can use an environment variable through its apiKeyEnv field.
OPENAI_API_KEY="your-openai-api-key-here"
DASHSCOPE_API_KEY="your-dashscope-api-key-here"
VOLCENGINE_API_KEY="your-volcengine-api-key-here"
